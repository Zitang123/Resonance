{
  "name": "karina-relay",
  "main": "worker.ts",
  "compatibility_date": "2026-09-07",
  "workers_dev": false,
  "preview_urls": false,
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "triggers": { "crons": [] },
  "durable_objects": {
    "bindings": [{ "name": "KARINA_CLOCK", "class_name": "KarinaClock" }],
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["KarinaClock"] }],
  "vars": {
    "RESONANCE_ORIGIN": "https://resonance-listening-room.zitang123.chatgpt.site",
  },
}
